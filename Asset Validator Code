#______________________________________ASSET NAME CHECK_________________________________________#
 
def asset_name_check(asset_sm):
    meshname = []
    asset_name = cmds.listRelatives(asset_sm, parent=True) 
    if (asset_name[0].startswith("SM_") and re.search(r"\d+$", asset_name[0])):  
        meshname.append(asset_name[0] + " = perfect")
    else:
        meshname.append(asset_name[0] + " = Notperfect")
    print("___Mesh name___")
    return meshname

#______________________________________TRANSFORM CHECK_________________________________________#

def Transform_check(asset_sm):
    transform = []
    pos = cmds.listRelatives(asset_sm,parent=True)[0]
    trans = cmds.xform(pos, query = True, translation=True)
    deg = cmds.getAttr(pos + ".rotate") 
    size = cmds.xform(pos, query = True, scale=True, worldSpace=True)
    if ((trans==[0.0, 0.0, 0.0]) and (deg==[(0.0,0.0,0.0)]) and (size==[1.0, 1.0, 1.0])):
	    transform.append((cmds.listRelatives(asset_sm, parent=True)[0]) + " = transform Perfect")
    else:
        if(trans!=[0.0, 0.0, 0.0]):
            transform.append(asset_sm + " = Moved")

        if(deg!=[(0.0,0.0,0.0)]):
            transform.append(asset_sm + " = Rotated")

        if(size!=[1.0, 1.0, 1.0]):
            transform.append(asset_sm + " = Scaled")
    print("___Transform check___")
    return transform

#______________________________________MESH EVALUATION_________________________________________#

def mesh_Evaluate(asset):
    # QUAD CHECK
    QC = []
    EC = []
    Quads = []
    Edgecheck = [] 
    face = cmds.polyEvaluate(asset, face=True)
    edge = cmds.polyEvaluate(asset, edge=True)
    vert = cmds.polyEvaluate(asset, vertex=True)		
    j=0
    for j in range(face):
        a = cmds.polyInfo(f"{asset}.f{[j]}", faceToVertex = True) # FACE 0: 0 1 2 3
        count = 0
        t1 = a[0].split(':')
        t2 = t1[1].split(' ')
        t=0
        index=0
        for t in range (len(t2)):
            if(t2[t]!=''):
                count=count+1
            t=t+1                
        q = count -1
        if((q != 4)):# & (q>4)):
            QC.append("Not a Quad = " + a[0])
            index = 1
    if(index!=1):
        QC.append("Its a QUAD")
            
    # EDGE CHECK
    j=0        
    for j in range(edge):
        a = cmds.polyInfo(f"{asset}.e{[j]}", edgeToFace = True) # FACE 0: 0 1 2 3
        count = 0
        t1 = a[0].split(':') # O/P as list
        t2 = t1[1].split(' ') # O/P as list 
        t=0
        q=0
        index=0
        for t in range(len(t2)):
            if(t2[t]!=''):
                count=count+1
            t=t+1                
        q = count-1
        if((q != 2) & (q != 1)):
            EC.append("non-manifold = " + f"{a[0]}")# + f"{q}")
            index = 1
    if(index!=1):
        EC.append("Its Manifold")      
    #print("___Mesh Evaluation___", QC, EC)
    #Quads.append(QC)
    #Edgecheck.append(EC)
    return (QC, EC)

    
