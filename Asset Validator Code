#______________________________________TEXTURE FILE CHECK_________________________________________#

def tex_path_connection(asset_sm):
    asset_sg = list(set(cmds.listConnections(asset_sm, type="shadingEngine")))
    texlist = []
        #print(asset_sm, asset_sg)
    for j in asset_sg:
        asset_m = cmds.listConnections(j + ".surfaceShader", source=True, destination=False)
        attr = ['baseColor', 'specularRoughness', 'metalness', 'opacity', 'normalCamera']

        for m in asset_m:
            tex = []
            for a in attr:
                connection = cmds.listConnections(m + "." + a)
                if connection:
                    tex_file= cmds.getAttr(connection[0] + ".fileTextureName") # os.path.exists(connection[0])
                    tex.append(f"{tex_file}")
                        #print(tex_file)
            #print("___Texture check___")
            texlist.append(f"{tex}\n")
            #with open(ResultPath, 'a') as wf:
                #wf.write(f"{tex}\n\n")
    return texlist
    
